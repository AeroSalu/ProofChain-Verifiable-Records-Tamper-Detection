ANTHROPIC_API_KEY=
PROOFCHAIN_DB_PATH=data/registry.db
PROOFCHAIN_LEDGER_PATH=data/ledger.jsonl
PROOFCHAIN_LEDGER_KEY_PATH=data/ledger_key.pem
PROOFCHAIN_LEDGER_URL=http://localhost:8001
# Shared secret for appending to the ledger. Required: set the same value for the ledger, the registry
# and the seed script. A ledger started without it refuses appends. Reading never needs it.
PROOFCHAIN_LEDGER_TOKEN=
# Signs the registry's session cookies (at least 32 characters). Leave unset to have one generated
# into data/session_secret on first run.
PROOFCHAIN_SESSION_SECRET=
PROOFCHAIN_AI_MODEL=claude-opus-5-5
